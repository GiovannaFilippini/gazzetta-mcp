# Copia questo file in /etc/gazzetta-archivio/variabili.env (permessi 640, vedi README).
# Formato: NOME=valore, una per riga, senza "export". Le righe con # sono commenti.
# Le variabili GAZZETTA_MCP_* sono quelle lette davvero dal codice (config.py, remoto.py).

# --- Indispensabili ---------------------------------------------------------------

# File dell'archivio (SQLite). Lo usano aggiorna, recupera, controlla, stato.
# (Il servizio web lo riceve con l'opzione --archivio nella sua unita' systemd:
# se cambi questo percorso, cambialo anche li'.)
GAZZETTA_MCP_ARCHIVIO_PATH=/var/lib/gazzetta-archivio/archivio.sqlite3

# Come si presenta il programma alla Gazzetta Ufficiale e a Normattiva. Metti un contatto
# vero: se serve, chi gestisce il sito sa a chi scrivere (decisione 090, "Acquisizione dalla GU").
GAZZETTA_MCP_USER_AGENT="gazzetta-mcp-archivio (unofficial open source; contatto: contatto@example.org)"

# --- Facoltative ------------------------------------------------------------------

# Richieste al secondo verso le fonti (default 1.0). NON alzarla senza motivo:
# e' il limite di cortesia verso il sito della Gazzetta.
# GAZZETTA_MCP_RPS=1.0

# Secondi di attesa massima per una risposta delle fonti (default 20).
# GAZZETTA_MCP_TIMEOUT=20

# Tetto ai caratteri di testo restituiti dal servizio per un atto (letto da remoto.py;
# minimo 1000; se manca o non e' un numero vale il default del codice).
# GAZZETTA_MCP_MAX_CHARS=

# Le serie servite al pubblico NON si scelgono qui ma con l'opzione --serie nella unita'
# systemd del servizio (di serie: --serie SG, solo Serie Generale e Normattiva).

# Percorso della cache locale. I comandi dell'archivio non la usano, ma la configurazione
# la calcola comunque: tenerla nella cartella dati evita che cerchi nella "home".
GAZZETTA_MCP_CACHE_PATH=/var/lib/gazzetta-archivio/cache.sqlite3

# --- Da NON cambiare (indirizzi delle fonti; servono solo per prove) ---------------
# GAZZETTA_MCP_GU_BASE_URL=https://www.gazzettaufficiale.it
# GAZZETTA_MCP_NORMATTIVA_BASE_URL=https://www.normattiva.it
# GAZZETTA_MCP_NORMATTIVA_API_URL=https://api.normattiva.it/t/normattiva.api/bff-opendata/v1/api/v1

# --- Lette dal codice ma NON pertinenti all'archivio (riguardano il server locale) ---
# GAZZETTA_MCP_RICERCA_GU, GAZZETTA_MCP_ARCHIVIO_NORMATTIVA, GAZZETTA_MCP_ARCHIVIO_TIMEOUT,
# GAZZETTA_MCP_ARCHIVIO_GIORNI, GAZZETTA_MCP_FEED_TTL, GAZZETTA_MCP_RECENT_ISSUES_SG

# --- Variabile del kit di installazione, NON del progetto ---------------------------
# Indirizzo che riceve un avviso (richiesta POST con il testo) quando un lavoro fallisce o il
# disco e' quasi pieno. Funziona con servizi come ntfy.sh o Healthchecks (vedi README,
# "Monitoraggio minimo"). Se resta vuoto gli avvisi finiscono solo nel registro di sistema.
AVVISO_URL=
