# Controllo dello spazio su disco (vedi disco.sh): se supera la soglia manda un avviso.
# Copia in /etc/systemd/system/.

[Unit]
Description=Archivio Gazzetta Ufficiale - controllo spazio su disco
OnFailure=gazzetta-avviso@%n.service

[Service]
Type=oneshot
User=gazzetta
Group=gazzetta-dati
EnvironmentFile=/etc/gazzetta-archivio/variabili.env
# Soglia in percentuale di disco usato. Cambiala qui se serve.
Environment=SOGLIA_DISCO=80
ExecStart=/usr/local/lib/gazzetta-archivio/disco.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
